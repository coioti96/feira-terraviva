# ============================================================
# Feirinha Orgânica Terra Viva — Environment Variables
# NUNCA commit este arquivo. Sempre use .env.local
# ============================================================

# ─────────────────────────────────────────────────────────────
# SUPABASE — Obrigatório
# Pegue em: https://supabase.com/dashboard/project/_/settings/api
# ─────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...anon_key_publica
VITE_SUPABASE_ANON_KEY=eyJ...anon_key_publica

# ⚠️ SERVICE ROLE KEY — SÓ SERVER-SIDE
# NUNCA exponha no frontend. Só server functions podem usar.
# Pegue em: Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role_secreta

# ─────────────────────────────────────────────────────────────
# MERCADO PAGO — Obrigatório para PIX automático
# Pegue em: https://www.mercadopago.com.br/developers/panel
# ─────────────────────────────────────────────────────────────
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-...
MERCADO_PAGO_PUBLIC_KEY=APP_USR-...
MERCADO_PAGO_CLIENT_ID=...
MERCADO_PAGO_CLIENT_SECRET=...
MERCADO_PAGO_WEBHOOK_SECRET=...

# ─────────────────────────────────────────────────────────────
# APP — Configurações gerais
# ─────────────────────────────────────────────────────────────
VITE_APP_NAME=Feirinha Orgânica Terra Viva
VITE_APP_URL=https://seudominio.vercel.app
VITE_APP_DESCRIPTION=Produtos orgânicos frescos da sua cidade

# ─────────────────────────────────────────────────────────────
# NEWS API — Para notícias (opcional)
# Pegue em: https://newsapi.org/register
# ─────────────────────────────────────────────────────────────
VITE_NEWS_API_KEY=

# ─────────────────────────────────────────────────────────────
# VERCEL — Deploy (opcional, só em produção)
# ─────────────────────────────────────────────────────────────
VERCEL_URL=
VERCEL_ENV=development